generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                BigInt             @id @default(autoincrement())
  sku               String             @unique
  name              String
  specialty         String
  category          String
  description       String?
  imageUrl          String?            @map("image_path")
  specifications    Json               @default("{}") @db.JsonB
  isAvailable       Boolean            @default(true) @map("is_available")
  quoteRequestItems QuoteRequestItem[]

  @@map("products")
}

model QuoteRequest {
  id             String             @id @default(cuid())
  reference      String             @unique @db.VarChar(7)
  firstName      String
  lastName       String
  organisation   String?
  email          String
  contactNumber  String
  address        String?
  notes          String?
  items          QuoteRequestItem[]
  consentVersion String
  consentedAt    DateTime           @default(now())
  // Preserve the existing database column and index for stored requests.
  submissionKey  String             @unique(map: "quote_requests_captchaId_key") @map("captchaId")
  createdAt      DateTime           @default(now())

  @@map("quote_requests")
}

model QuoteRequestItem {
  id             BigInt       @id @default(autoincrement())
  quoteRequestId String
  productId      BigInt
  quantity       Int
  skuSnapshot    String
  nameSnapshot   String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([quoteRequestId, productId])
  @@index([productId])
  @@map("quote_request_items")
}
