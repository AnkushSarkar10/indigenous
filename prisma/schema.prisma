generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  NEW        @map("new")
  CONTACTED  @map("contacted")
  QUOTE_SENT @map("quote_sent")
  CONFIRMED  @map("confirmed")
  COMPLETED  @map("completed")
  CANCELLED  @map("cancelled")

  @@map("request_status")
}

model Product {
  id             BigInt             @id @default(autoincrement())
  sku            String             @unique
  name           String
  category       String?
  description    String?
  imageUrl       String?            @map("image_url")
  specifications Json               @default("{}") @db.JsonB
  isActive       Boolean            @default(true) @map("is_active")
  requestItems   OrderRequestItem[]

  @@index([category, isActive])
  @@map("products")
}

model OrderRequest {
  id            BigInt             @id @default(autoincrement())
  requestCode   String             @unique @default(dbgenerated("concat('REQ-', nextval('request_code_seq'::regclass))")) @map("request_code")
  status        RequestStatus      @default(NEW)
  hospitalName  String             @map("hospital_name")
  contactPerson String             @map("contact_person")
  contactPhone  String             @map("contact_phone")
  notes         String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  items         OrderRequestItem[]

  @@index([status, createdAt(sort: Desc)])
  @@map("order_requests")
}

model OrderRequestItem {
  id        BigInt       @id @default(autoincrement())
  requestId BigInt       @map("request_id")
  productId BigInt?      @map("product_id")
  quantity  Int
  request   OrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product   Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([requestId, productId])
  @@index([productId])
  @@map("order_request_items")
}
