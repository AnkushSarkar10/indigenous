generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id             BigInt  @id @default(autoincrement())
  sku            String  @unique
  name           String
  specialty      String
  category       String
  description    String?
  imageUrl       String? @map("image_path")
  specifications Json    @default("{}") @db.JsonB
  isAvailable    Boolean @default(true) @map("is_available")

  @@map("products")
}
