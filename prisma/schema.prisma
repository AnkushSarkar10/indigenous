generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id             BigInt  @id @default(autoincrement())
  sku            String  @unique
  name           String
  specialty      String
  category       String
  description    String?
  imageUrl       String? @map("image_path")
  specifications Json    @default("{}") @db.JsonB
  isAvailable    Boolean @default(true) @map("is_available")

  @@map("products")
}

model QuoteRequest {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  organisation     String
  email            String
  contactNumber    String
  address          String
  notes            String?
  items            Json     @db.JsonB
  consentVersion   String
  consentedAt      DateTime @default(now())
  // Preserve the existing database column and index for stored requests.
  submissionKey    String   @unique(map: "quote_requests_captchaId_key") @map("captchaId")
  createdAt        DateTime @default(now())

  @@map("quote_requests")
}
