# PostgreSQL connection strings for the app and Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# Configure with pnpm admin:setup. These values are server-only.
NUXT_ADMIN_EMAIL=
NUXT_ADMIN_PASSWORD_HASH=
# Random secret of at least 32 characters; changing credentials invalidates sessions.
NUXT_ADMIN_SESSION_SECRET=

# Sending-only Resend key. Never expose this through public runtime config.
RESEND_API_KEY=
NUXT_RESEND_FROM_EMAIL="Indigenous <onboarding@resend.dev>"
NUXT_RESEND_QUOTE_TEMPLATE_ID=
# Enable only after applying migrations and configuring the published template.
NUXT_QUOTE_EMAIL_ENABLED=false
